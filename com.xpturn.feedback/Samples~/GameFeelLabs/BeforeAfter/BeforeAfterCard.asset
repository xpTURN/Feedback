  m_Script: {fileID: 11500000, guid: 7265114aa1e7f41ada19d74a427f9e13, type: 3}
  m_Name: BeforeAfterCard
  m_EditorClassIdentifier: xpTURN.Feedback.Samples::xpTURN.Feedback.Samples.SampleCard
  Title: Before / After
  Try: "Run and jump \u2014 both sides move the same. Turn the right side's layers
    on and off with Z X C V (or the buttons) and see what each one adds."
  See: "The left side has no feedback. The right side plays four layers: squash (the
    Jump and Land presets), dust (particles), camera (a shake on its own camera)
    and trail. Tab turns every layer off \u2014 both sides are then Before."
  Controls: "A D \xB7 \u2190 \u2192 \xB7 Left stick \u2014 run \xB7 Space \xB7 Gamepad
    South \u2014 jump \xB7 Z X C V \xB7 D-pad \u2014 layers"
  SceneGuid: c18d044c26ecb49119c6ad4db1b1b3f2
  SceneName: BeforeAfter
  RequiredType: xpTURN.Feedback.Samples.GameFeelLabs.BeforeAfterLab, xpTURN.Feedback.Samples.GameFeelLabs.BeforeAfter
  RequiresText: the Particle System module
  OpenInEditor: 0
